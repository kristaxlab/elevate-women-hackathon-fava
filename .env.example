# Copy to .env and fill in. Never commit .env.

# Database (defaults match docker-compose.yml)
FAVA_DB_URL=jdbc:postgresql://localhost:5432/fava
FAVA_DB_USERNAME=fava
FAVA_DB_PASSWORD=fava

# Telegram (required from issue #2 onward)
FAVA_TELEGRAM_BOT_TOKEN=
# Optional; if empty and a token is set, Fava resolves the username via getMe at poller start
FAVA_TELEGRAM_BOT_USERNAME=

# OpenRouter / OpenAI-compatible gateway (required from AI slices onward)
FAVA_OPENROUTER_API_KEY=
FAVA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model id for Classifier Decisions and Catalog Answers
FAVA_OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Embedding model for Smart Search RAG (1536 dims; must match pgvector column)
FAVA_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional
FAVA_SERVER_PORT=8080
